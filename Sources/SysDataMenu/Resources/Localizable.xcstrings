          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld скрыто"
          }
        }
      }
    },
    "%lld items need root; the password is asked once.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个项目需要 root 权限；只需输入一次密码。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld kalem yönetici yetkisi istiyor; parola bir kez sorulur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 項目に管理者権限が必要です。パスワードは一度だけ求められます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Objekte benötigen Root-Rechte; das Passwort wird einmal abgefragt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld éléments nécessitent les droits root ; le mot de passe est demandé une seule fois."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld elementos requieren acceso de administrador; se pedirá la contraseña una sola vez."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개 항목에 관리자 권한이 필요합니다. 암호는 한 번만 요청됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для %lld объектов нужны права root; пароль будет запрошен один раз."
          }
        }
      }
    },
    "%lld items need root; the password may be asked more than once.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个项目需要 root 权限；可能需要多次输入密码。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld kalem yönetici yetkisi istiyor; parola birden fazla kez sorulabilir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 項目に管理者権限が必要です。パスワードが複数回求められることがあります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Objekte benötigen Root-Rechte; das Passwort wird möglicherweise mehrfach abgefragt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld éléments nécessitent les droits root ; le mot de passe peut être demandé plusieurs fois."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld elementos requieren acceso de administrador; puede que se pida la contraseña más de una vez."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개 항목에 관리자 권한이 필요합니다. 암호가 여러 번 요청될 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для %lld объектов нужны права root; пароль может быть запрошен несколько раз."
          }
        }
      }
    },
    "%lld marked Review go to the Trash: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个标记为“需确认”的项目将移到废纸篓：%@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld tanesi İncele işaretli, Çöp Sepeti'ne gider: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「確認」の %lld 項目はゴミ箱へ移動します：%@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld als „Prüfen“ markierte Objekte wandern in den Papierkorb: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld éléments marqués À vérifier iront à la Corbeille : %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld marcados como Revisar irán a la Papelera: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검토로 표시된 %lld개 항목이 휴지통으로 이동합니다: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld объектов с пометкой «Проверить» будут перемещены в Корзину: %@"
          }
        }
      }
    },
