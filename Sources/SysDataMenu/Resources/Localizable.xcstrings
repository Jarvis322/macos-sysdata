          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld дн. без использования"
          }
        }
      }
    },
    "%lld hidden": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已隐藏 %lld 项"
          }
        },
        "tr": {
