  "strings": {
    "%@ System Data · %@ free": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Sistem Verileri · %@ boş"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 系统数据 · %@ 可用"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムデータ %@ · 空き %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Systemdaten · %@ frei"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de données système · %@ libres"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
