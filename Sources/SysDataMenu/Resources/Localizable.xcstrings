        }
      }
    },
    "Cancelled. Nothing was deleted.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İptal edildi. Hiçbir şey silinmedi."
