          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 데이터 %@ · 여유 공간 %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные системы: %@ · свободно %@"
          }
        }
      }
    },
    "%@ System Data · %@ free · %@ this week": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Sistem Verileri · %@ boş · bu hafta %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 系统数据 · %@ 可用 · 本周 %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムデータ %@ · 空き %@ · 今週 %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Systemdaten · %@ frei · %@ diese Woche"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
