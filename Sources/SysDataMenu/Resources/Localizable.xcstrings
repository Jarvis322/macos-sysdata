            "state": "translated",
            "value": "Hepsini unut"
          }
        }
      }
    },
    "Free space on the startup disk.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlangıç diskindeki boş alan."
          }
        }
      }
    },
    "Frees about %@. ": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaklaşık %@ boşaltır. "
