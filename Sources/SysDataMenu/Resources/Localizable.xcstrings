            "state": "translated",
            "value": "主に %1$@、%2$@ 増加しました。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hauptsächlich %@, %@ mehr."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Principalement %@, en hausse de %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Principalmente %@, un aumento de %@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대부분 %@, %@ 증가."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Главным образом %@, рост на %@."
          }
        }
      }
    },
    "Move safe items to the Trash": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenli öğeleri Çöp Sepeti'ne taşı"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将可安全清理的项目移到废纸篓"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全な項目をゴミ箱に入れる"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichere Elemente in den Papierkorb verschieben"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacer les éléments sûrs vers la Corbeille"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover los elementos seguros a la Papelera"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전 항목을 휴지통으로 이동"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемещать безопасные элементы в Корзину"
          }
        }
      }
    },
    "Moved to the Trash. Empty the Trash to free the space.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已移到废纸篓。清倒废纸篓以释放空间。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çöp Sepeti'ne taşındı. Alanı boşaltmak için Çöp Sepeti'ni boşaltın."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱に移動しました。容量を解放するにはゴミ箱を空にしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den Papierkorb verschoben. Leere den Papierkorb, um den Speicherplatz freizugeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacé vers la Corbeille. Videz la Corbeille pour libérer l'espace."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se movió a la Papelera. Vacía la Papelera para liberar el espacio."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통으로 이동했습니다. 공간을 확보하려면 휴지통을 비우세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемещено в Корзину. Чтобы освободить место, очистите Корзину."
          }
        }
      }
    },
    "No item matches": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有匹配的项目"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşleşen öğe yok"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一致する項目がありません"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Übereinstimmung"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun élément ne correspond"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún elemento coincide"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일치하는 항목 없음"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет совпадений"
          }
        }
      }
    },
    "Nothing to compare yet": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无可比较的记录"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz karşılaştıracak bir şey yok"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ比較できるものがありません"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts zum Vergleichen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à comparer pour l'instant"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay nada que comparar"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 비교할 항목 없음"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нечего сравнивать"
          }
        }
      }
    },
    "Nothing to reclaim": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可释放的空间"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri kazanılacak bir şey yok"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解放できるものがありません"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts freizugeben"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à récupérer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada que recuperar"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확보할 공간 없음"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нечего освобождать"
          }
        }
      }
    },
    "Notify about unusual growth": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "异常增长通知"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olağandışı büyüme için bildirim gönder"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "異常な増加を通知"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über ungewöhnliches Wachstum informieren"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifier une croissance inhabituelle"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificar un crecimiento inusual"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비정상적인 증가 알림"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомлять о необычном росте"
          }
        }
      }
    },
    "Once a day, alert you when a storage category has grown far beyond its recent size. Nothing leaves your Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当存储分类远高于近期大小时，每天提醒一次。数据不会离开您的 Mac。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir depolama kategorisi son dönem boyutunun çok üstüne çıktığında günde bir kez bildir. Hiçbir veri Mac'inizden ayrılmaz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストレージカテゴリが最近のサイズを大きく超えたとき、1日1回通知します。データがMacから送信されることはありません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal täglich informieren, wenn eine Speicherkategorie deutlich über ihre jüngste Größe wächst. Keine Daten verlassen deinen Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous alerte une fois par jour lorsqu'une catégorie de stockage dépasse largement sa taille récente. Aucune donnée ne quitte votre Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te avisa una vez al día cuando una categoría de almacenamiento supera ampliamente su tamaño reciente. No sale ningún dato de tu Mac."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 공간 카테고리가 최근 크기를 크게 넘어서면 하루에 한 번 알립니다. 데이터는 Mac을 떠나지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раз в день уведомляет, если категория хранилища сильно превысила недавний размер. Данные не покидают ваш Mac."
          }
        }
      }
    },
    "Once a week, delete the items marked Safe — the caches that regenerate — and notify you what was freed. Never anything that needs review or a password.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftada bir, Güvenli işaretli öğeleri — yeniden oluşan önbellekleri — siler ve neyin boşaltıldığını bildirir. İncelenmesi gereken veya parola isteyen hiçbir şeye asla dokunmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每周一次，删除标记为“可安全清理”的项目（会自动重建的缓存），并通知你清理了多少。绝不触碰任何需要检查或密码的内容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "週に一度、「安全」と記された項目（再生成されるキャッシュ）を削除し、解放した容量を通知します。確認やパスワードが必要なものには一切触れません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal pro Woche werden die als „Sicher“ markierten Elemente – die Caches, die sich von selbst neu aufbauen – gelöscht, und du wirst benachrichtigt, wie viel freigegeben wurde. Nie etwas, das eine Überprüfung oder ein Passwort erfordert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois par semaine, supprime les éléments marqués Sûr — les caches qui se régénèrent — et vous informe de l'espace libéré. Jamais un élément nécessitant une vérification ou un mot de passe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez a la semana, elimina los elementos marcados como Seguro (las cachés que se regeneran) y te avisa de cuánto se liberó. Nunca nada que necesite revisión o una contraseña."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일주일에 한 번, '안전'으로 표시된 항목(다시 생성되는 캐시)을 삭제하고 얼마나 비웠는지 알려줍니다. 검토가 필요하거나 암호가 필요한 항목은 절대 삭제하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раз в неделю удалять элементы с пометкой «Безопасно» — кеши, которые восстанавливаются заново, — и уведомлять о том, сколько места было освобождено. Никогда ничего, что требует проверки или пароля."
          }
        }
      }
    },
    "Once a week, if System Data has grown, a notification says by how much and what grew most. Nothing leaves your Mac.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftada bir, Sistem Verileri büyüdüyse ne kadar ve en çok neyin büyüdüğünü bir bildirim söyler. Hiçbir şey Mac'inden çıkmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每周一次，如果系统数据增长了，通知会告诉你增长了多少以及增长最多的是什么。任何数据都不会离开你的 Mac。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "週に一度、システムデータが増えていれば、どれだけ、何が最も増えたかを通知でお知らせします。データが Mac の外に出ることはありません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal pro Woche wird dir, falls die Systemdaten gewachsen sind, per Benachrichtigung mitgeteilt, um wie viel und was am meisten gewachsen ist. Nichts verlässt deinen Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois par semaine, si Données système a augmenté, une notification indique de combien et ce qui a le plus augmenté. Rien ne quitte votre Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez a la semana, si Datos del sistema ha aumentado, una notificación indica cuánto y qué creció más. Nada sale de tu Mac."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일주일에 한 번, 시스템 데이터가 늘어났다면 얼마나 늘었는지, 무엇이 가장 많이 늘었는지 알림으로 알려줍니다. Mac에서 아무것도 삭제되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раз в неделю, если объём «Данных системы» увеличился, приходит уведомление о том, насколько и что выросло больше всего. Ничего не покидает ваш Mac."
          }
        }
      }
    },
    "One grant covers everything. Until then this scan leaves the protected places alone — app containers, Desktop, Documents, Music, Photos — rather than asking about them one app at a time, so what you see below is incomplete. Add System Data Unpacked in the settings pane, then reopen the app.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次授权即可涵盖所有位置。在授权前，扫描会跳过受保护的位置（应用容器、桌面、文稿、音乐、照片），而不会逐个应用请求权限，因此下方结果并不完整。请在“完全磁盘访问权限”设置中添加“System Data Unpacked”，然后重新打开应用。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek izin hepsini kapsar. O zamana kadar bu tarama korumalı yerlere dokunmuyor — uygulama konteynerleri, Masaüstü, Belgeler, Müzik, Fotoğraflar — tek tek izin sormaktansa; yani aşağıda gördüğün eksik. Ayarlar bölmesinden System Data Unpacked'ı ekle, sonra uygulamayı yeniden aç."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 回の許可ですべてに対応できます。それまでこのスキャンは保護された場所——Appコンテナ、デスクトップ、書類、ミュージック、写真——には触れず、Appごとに個別に確認を求めることもしません。そのため下に表示される内容は不完全です。設定パネルで「System Data Unpacked」を追加してから、Appを開き直してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine einzige Freigabe deckt alles ab. Bis dahin lässt dieser Scan die geschützten Orte unangetastet — App-Container, Schreibtisch, Dokumente, Musik, Fotos — anstatt einzeln pro App nachzufragen. Was du unten siehst, ist deshalb unvollständig. Füge „System Data Unpacked“ im Einstellungsbereich hinzu und öffne die App danach erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une seule autorisation suffit pour tout. En attendant, cette analyse laisse les emplacements protégés de côté — conteneurs d'apps, Bureau, Documents, Musique, Photos — plutôt que de vous les demander un par un ; ce que vous voyez ci-dessous est donc incomplet. Ajoutez System Data Unpacked dans le volet des réglages, puis rouvrez l'app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo permiso lo cubre todo. Hasta entonces, este análisis no toca los lugares protegidos —contenedores de apps, Escritorio, Documentos, Música, Fotos— en lugar de preguntar por cada app una por una, así que lo que ves a continuación está incompleto. Añade System Data Unpacked en el panel de ajustes y vuelve a abrir la app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번만 허용하면 모든 항목에 적용됩니다. 허용하기 전까지 이 검사는 앱 컨테이너, 데스크탑, 문서, 음악, 사진 같은 보호된 위치는 앱마다 개별적으로 묻는 대신 그대로 건너뛰므로, 아래 목록은 완전하지 않습니다. 설정 화면에서 System Data Unpacked를 추가한 다음 앱을 다시 여세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одного разрешения достаточно для всего. До этого момента сканирование не затрагивает защищённые места — контейнеры приложений, Рабочий стол, Документы, Музыку, Фото, — вместо того чтобы запрашивать доступ для каждого приложения по отдельности, поэтому список ниже неполон. Добавьте «System Data Unpacked» в настройках, затем откройте приложение заново."
          }
        }
      }
    },
    "Open Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开设置"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarları Aç"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を開く"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen öffnen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir les réglages"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir Ajustes"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 열기"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть настройки"
          }
        }
      }
    },
    "Open Unpacked to see what grew.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neyin büyüdüğünü görmek için Unpacked'ı aç."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Unpacked 查看增长了什么。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何が増えたかを確認するには Unpacked を開いてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Unpacked, um zu sehen, was gewachsen ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Unpacked pour voir ce qui a augmenté."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Unpacked para ver qué creció."
          }
        },
        "ko": {
