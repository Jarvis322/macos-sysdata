{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "%@ free on disk": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘可用空间：%@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "diskte %@ boş"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスクの空き容量：%@"
          }
        }
      }
    },
    "%@ safe to free now · %@ free on disk · %@ purgeable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前可安全释放 %@ · 磁盘可用空间 %@ · 可清除空间 %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ güvenle boşaltılabilir · diskte %@ boş · %@ temizlenebilir"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐ安全に解放：%@ · ディスクの空き：%@ · パージ可能：%@"
          }
        }
      }
    },
    "%lld days idle": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 天未变动"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld gündür boşta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 日未使用"
          }
        }
      }
    },
    "%lld hidden": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已隐藏 %lld 项"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld gizli"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件非表示"
          }
        }
      }
    },
    "%lld items need root; the password is asked once.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个项目需要 root 权限；只需输入一次密码。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld kalem yönetici yetkisi istiyor; parola bir kez sorulur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 項目に管理者権限が必要です。パスワードは一度だけ求められます。"
          }
        }
      }
    },
    "%lld items need root; the password may be asked more than once.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个项目需要 root 权限；可能需要多次输入密码。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld kalem yönetici yetkisi istiyor; parola birden fazla kez sorulabilir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 項目に管理者権限が必要です。パスワードが複数回求められることがあります。"
          }
        }
      }
    },
    "%lld marked Review go to the Trash: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个标记为“需确认”的项目将移到废纸篓：%@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld tanesi İncele işaretli, Çöp Sepeti'ne gider: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「確認」の %lld 項目はゴミ箱へ移動します：%@"
          }
        }
      }
    },
    "%lld months idle": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个月未变动"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld aydır boşta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld か月未使用"
          }
        }
      }
    },
    "%lld not on screen": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 项未显示在当前界面中"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld tanesi ekranda değil"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件は画面外"
          }
        }
      }
    },
    "%lld years idle": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 年未变动"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld yıldır boşta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 年未使用"
          }
        }
      }
    },
    "1 item needs root.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 个项目需要 root 权限。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 kalem yönetici yetkisi istiyor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 項目に管理者権限が必要です。"
          }
        }
      }
    },
    "1 month idle": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 个月未变动"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 aydır boşta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 か月未使用"
          }
        }
      }
    },
    "1 year idle": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 年未变动"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 yıldır boşta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 年未使用"
          }
        }
      }
    },
    "After a second scan this shows what grew, and whether anything you deleted came back.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次扫描后，这里会显示哪些项目占用的空间增加了，以及已删除的项目是否重新出现。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İkinci taramadan sonra burada ne büyüdüğü ve sildiğin bir şeyin geri gelip gelmediği görünür."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2 回目以降のスキャンで、何が増えたか、削除したものが戻っていないかを表示します。"
          }
        }
      }
    },
    "Android": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android"
          }
        }
      }
    },
    "App data & caches": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用数据与缓存"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama verileri ve önbellekler"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appのデータとキャッシュ"
          }
        }
      }
    },
    "As administrator: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以管理员身份执行：%@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yönetici olarak: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理者として実行：%@"
          }
        }
      }
    },
    "Asks GitHub once a day whether a newer version exists. It is the only request this app makes; leave it off and nothing leaves your Mac.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天向 GitHub 检查一次是否有新版本。这是此应用唯一的网络请求；保持关闭时，不会从你的 Mac 向外发送任何数据。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günde bir kez GitHub'a yeni sürüm olup olmadığını sorar. Uygulamanın yaptığı tek istek budur; kapalı bırakırsanız Mac'inizden hiçbir şey çıkmaz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいバージョンがあるか、1 日に一度 GitHub に問い合わせます。このAppが行う唯一の通信です。オフにすれば、Macから何も送信されません。"
          }
        }
      }
    },
    "Back to the list": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回列表"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listeye dön"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストに戻る"
          }
        }
      }
    },
    "Booted simulators ignore the quit request and hold the shutdown for 33 seconds. This shuts them down first.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已启动的模拟器会忽略退出请求，导致关机延迟 33 秒。此选项会先关闭模拟器。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık simülatörler çıkış isteğini yok sayar ve kapanışı 33 saniye bekletir. Bu seçenek önce onları kapatır."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動中のシミュレータは終了要求を無視し、シャットダウンを 33 秒間止めます。これは先にシミュレータを終了させます。"
          }
        }
      }
    },
    "Came back": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新出现"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri geldi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "戻ってきた"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vazgeç"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        }
      }
    },
    "Cancelled. %d already deleted, the rest left alone.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消。已删除 %d 项，其余项目未作更改。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İptal edildi. %d tanesi silinmişti, kalanlara dokunulmadı."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセルしました。%d 件は削除済み、残りはそのままです。"
          }
        }
      }
    },
    "Cancelled. Nothing was deleted.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消。未删除任何内容。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İptal edildi. Hiçbir şey silinmedi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセルしました。何も削除されていません。"
          }
        }
