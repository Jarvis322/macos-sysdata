          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe lokal Protokoll über jeden Scan und jede Löschung, damit die Liste zeigen kann, was sich geändert hat"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserver un historique local de chaque analyse et suppression, afin que la liste puisse montrer ce qui a changé"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar un registro local de cada análisis y eliminación, para que la lista pueda mostrar qué cambió"
