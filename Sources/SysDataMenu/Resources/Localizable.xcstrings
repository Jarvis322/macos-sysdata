      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En çok büyüyen"
          }
        }
      }
    },
    "Hide %@ from future scans": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ öğesini sonraki taramalarda gizle"
          }
