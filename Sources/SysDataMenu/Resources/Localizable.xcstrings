    "Delete files older than %lld days in %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除 %2$@ 中超过 %1$lld 天的文件"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ içinde %1$lld günden eski dosyalar silinir"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 内の %1$lld 日より古いファイルを削除"
          }
        }
      }
    },
    "Delete the history file": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除历史记录文件"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmiş dosyasını sil"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴ファイルを削除"
          }
        }
      }
    },
    "Deleted": {
      "localizations": {
