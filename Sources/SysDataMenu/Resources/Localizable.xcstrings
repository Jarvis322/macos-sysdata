{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "%@ free on disk": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "diskte %@ boş"
          }
        }
      }
    },
    "%@ safe to free now · %@ free on disk · %@ purgeable": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ güvenle boşaltılabilir · diskte %@ boş · %@ temizlenebilir"
          }
        }
      }
    },
    "%lld hidden": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld gizli"
          }
        }
      }
    },
    "%lld items need root; the password is asked once.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld kalem yönetici yetkisi istiyor; parola bir kez sorulur."
          }
        }
      }
    },
    "%lld marked Review go to the Trash: %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld tanesi İncele işaretli, Çöp Sepeti'ne gider: %@"
          }
        }
      }
    },
    "1 item needs root; the password is asked once.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 kalem yönetici yetkisi istiyor; parola bir kez sorulur."
          }
        }
      }
    },
    "Android": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android"
          }
        }
      }
    },
    "App data & caches": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama verileri ve önbellekler"
          }
        }
      }
    },
    "Asks GitHub once a day whether a newer version exists. It is the only request this app makes; leave it off and nothing leaves your Mac.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günde bir kez GitHub'a yeni sürüm olup olmadığını sorar. Uygulamanın yaptığı tek istek budur; kapalı bırakırsanız Mac'inizden hiçbir şey çıkmaz."
          }
        }
      }
    },
    "Booted simulators ignore the quit request and hold the shutdown for 33 seconds. This shuts them down first.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık simülatörler çıkış isteğini yok sayar ve kapanışı 33 saniye bekletir. Bu seçenek önce onları kapatır."
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vazgeç"
          }
        }
      }
    },
    "Cancelled. %d already deleted, the rest left alone.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İptal edildi. %d tanesi silinmişti, kalanlara dokunulmadı."
