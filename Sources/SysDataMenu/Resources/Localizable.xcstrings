        }
      }
    },
    "%@ free on disk": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘可用空间：%@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "diskte %@ boş"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスクの空き容量：%@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ frei auf der Festplatte"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ disponible sur le disque"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ libres en el disco"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스크에 %@ 여유 공간"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ свободно на диске"
          }
        }
      }
    },
    "%@ free · %@ of safe items can go now": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ boş · %@ güvenli öğe şimdi silinebilir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 可用 · 现在可清理 %@ 可安全清理的项目"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の空き · 安全な項目 %@ を今すぐ削除できます"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ frei · %@ an sicheren Elementen können jetzt entfernt werden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de libre · %@ d'éléments sûrs peuvent être supprimés maintenant"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ libres · %@ de elementos seguros se pueden liberar ahora"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 여유 공간 · 안전 항목 %@ 삭제 가능"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ свободно · %@ безопасных элементов можно освободить прямо сейчас"
          }
        }
      }
    },
    "%@ grew %@ beyond its recent size.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 比近期大小增加了 %@。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ son dönem boyutunun %@ üstüne çıktı."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は最近のサイズより %@ 増えました。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist um %@ über seine jüngste Größe gewachsen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a augmenté de %@ au-delà de sa taille récente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ creció %@ por encima de su tamaño reciente."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 최근 크기보다 %@ 늘었습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ вырос на %@ по сравнению с недавним размером."
          }
        }
      }
    },
    "%@ safe to free now · %@ free on disk · %@ purgeable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前可安全释放 %@ · 磁盘可用空间 %@ · 可清除空间 %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ güvenle boşaltılabilir · diskte %@ boş · %@ temizlenebilir"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐ安全に解放：%@ · ディスクの空き：%@ · パージ可能：%@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sicher freizugeben · %@ frei auf der Festplatte · %@ löschbar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ à libérer sans risque · %@ disponible sur le disque · %@ purgeable"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ seguro para liberar ahora · %@ libres en el disco · %@ purgable"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 안전하게 확보할 수 있는 %@ · 디스크 여유 공간 %@ · 제거 가능한 공간 %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ можно безопасно освободить сейчас · %@ свободно на диске · %@ вытесняемых данных"
          }
        }
      }
    },
    "%@ safe · %@ to review · %@ manual": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ güvenli · %@ incelenecek · %@ manuel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 可安全清理 · %@ 需检查 · %@ 需手动处理"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全 %@ · 要確認 %@ · 手動 %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sicher · %@ zu prüfen · %@ manuell"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sûr · %@ à vérifier · %@ manuel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ seguro · %@ por revisar · %@ manual"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전 %@ · 검토 필요 %@ · 수동 %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "безопасно: %@ · проверить: %@ · вручную: %@"
          }
        }
      }
    },
    "%@: the simulator is still running. Quit Simulator and Xcode, then try again.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: simülatör hâlâ çalışıyor. Simulator'ı ve Xcode'u kapatıp tekrar dene."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：模拟器仍在运行。请退出 Simulator 和 Xcode 后重试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：シミュレータがまだ実行中です。Simulator と Xcode を終了してから、もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Der Simulator läuft noch. Beende Simulator und Xcode und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : le simulateur est toujours en cours d’exécution. Quittez Simulator et Xcode, puis réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: el simulador sigue en ejecución. Cierra Simulator y Xcode e inténtalo de nuevo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: 시뮬레이터가 아직 실행 중입니다. Simulator와 Xcode를 종료한 후 다시 시도하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: симулятор всё ещё запущен. Закройте Simulator и Xcode и повторите попытку."
          }
        }
      }
    },
    "%lld days idle": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 天未变动"
          }
