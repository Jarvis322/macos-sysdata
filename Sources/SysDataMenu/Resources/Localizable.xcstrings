          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 데이터 %@ · 여유 공간 %@ · 이번 주 %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные системы: %@ · свободно %@ · за неделю %@"
